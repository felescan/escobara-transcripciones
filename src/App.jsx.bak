            <h1 className="mt-10 text-4xl font-extrabold leading-tight sm:text-5xl lg:text-7xl">
              Transformamos

              <span className="bg-gradient-to-r from-cyan-400 to-blue-500 bg-clip-text text-transparent">
                {" "}audio y video{" "}
