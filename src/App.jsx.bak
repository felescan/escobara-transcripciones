                  </p>

                  <p className="mt-2 text-lg font-semibold">
                    transcripcion_final.docx
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* SERVICES */}
      <section id="servicios" className="relative mx-auto max-w-7xl px-6 py-28">
